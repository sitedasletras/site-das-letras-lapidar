<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Idioma da obra — Lapidar</title>

<style>
body{
margin:0;
font-family:Arial, sans-serif;
background:#0d0603;
color:white;
display:flex;
justify-content:center;
}

.container{
max-width:760px;
width:92%;
padding:40px 0 60px 0;
}

.titulo{
font-size:36px;
text-align:center;
font-weight:bold;
}

.epigrafe{
text-align:center;
font-style:italic;
color:#ffe6c9;
margin-top:10px;
line-height:1.7;
}

.subtitulo{
text-align:center;
color:#ff7b2c;
margin-top:16px;
margin-bottom:28px;
line-height:1.6;
}

.card{
background:#140c08;
border-radius:14px;
padding:24px;
margin-top:18px;
line-height:1.7;
}

label{
display:block;
margin-top:16px;
margin-bottom:6px;
font-weight:bold;
color:#ffd2b3;
}

select{
width:100%;
padding:14px;
border-radius:10px;
border:none;
box-sizing:border-box;
font-size:16px;
}

.info{
margin-top:14px;
font-size:14px;
color:#ffcfaa;
line-height:1.7;
}

.status{
margin-top:16px;
color:#9cffb2;
font-weight:bold;
line-height:1.6;
text-align:center;
}

.botaoIdioma{
width:100%;
padding:18px;
margin-top:18px;
border-radius:40px;
border:2px solid #ff7b2c;
background:white;
color:#111;
font-size:18px;
font-weight:bold;
cursor:pointer;
}

.botaoIdioma:hover{
background:#fff6ef;
}

.botaoCinza{
width:100%;
padding:18px;
margin-top:18px;
border:none;
border-radius:40px;
background:#444;
color:white;
font-size:18px;
font-weight:bold;
cursor:pointer;
}

.botaoCinza:hover{
background:#666;
}
</style>
</head>
<body>

<div class="container">

<div class="titulo">
Idioma da obra
</div>

<div class="epigrafe">
Opus tuum in alias linguas conversum a Lapidare
</div>

<div class="subtitulo">
Reescreva sua obra em outra língua com estrutura editorial preservada
</div>

<div class="card">

<label for="idiomaOriginal">
Idioma original da obra
</label>

<select id="idiomaOriginal">
<option value="pt">Português</option>
<option value="en">English</option>
<option value="es">Español</option>
<option value="it">Italiano</option>
<option value="fr">Français</option>
<option value="de">Deutsch</option>
</select>

<label for="idiomaDestino">
Novo idioma da obra
</label>

<select id="idiomaDestino">
<option value="en">English</option>
<option value="es">Español</option>
<option value="it">Italiano</option>
<option value="fr">Français</option>
<option value="de">Deutsch</option>
<option value="pt">Português</option>
</select>

<div class="info">
O módulo de idiomas funciona como ferramenta própria do ecossistema Lapidar.
</div>

<div class="info">
A estrutura editorial da obra será preservada durante a conversão multilíngue.
</div>

<div class="info">
Este recurso pode funcionar como parte do Lapidar ou como ferramenta independente.
</div>

<div id="statusIdioma" class="status"></div>

<button class="botaoIdioma" onclick="registrarIdiomaObra()">
Reescrever minha obra em outro idioma
</button>

<button class="botaoCinza" onclick="window.location.href='_Indice.html'">
Voltar para a casa do original
</button>

</div>

</div>

<script>

function detectarIdiomaBase(){

const idiomaSalvo =
localStorage.getItem("SDL_idioma_obra_global") ||
localStorage.getItem("SDL_idioma_obra") ||
"pt";

document.getElementById("idiomaOriginal").value = idiomaSalvo;

ajustarIdiomaDestino(idiomaSalvo);

}

function ajustarIdiomaDestino(idiomaOriginal){

const selectDestino =
document.getElementById("idiomaDestino");

const opcoes =
Array.from(selectDestino.options);

for(let i = 0; i < opcoes.length; i++){
opcoes[i].disabled = false;
}

for(let i = 0; i < opcoes.length; i++){
if(opcoes[i].value === idiomaOriginal){
opcoes[i].disabled = true;
}
}

if(selectDestino.value === idiomaOriginal){
for(let i = 0; i < opcoes.length; i++){
if(!opcoes[i].disabled){
selectDestino.value = opcoes[i].value;
break;
}
}
}

}

function registrarIdiomaObra(){

const idiomaOriginal =
document.getElementById("idiomaOriginal").value;

const idiomaDestino =
document.getElementById("idiomaDestino").value;

if(idiomaOriginal === idiomaDestino){
alert("Escolha um idioma diferente do idioma original da obra.");
return;
}

localStorage.setItem("SDL_idioma_obra", idiomaOriginal);
localStorage.setItem("SDL_idioma_obra_global", idiomaOriginal);
localStorage.setItem("SDL_idioma_extra", idiomaDestino);
localStorage.setItem("SDL_servico_extra", "idioma_obra");
localStorage.setItem("SDL_modulo_idioma_obra", "ativo");

document.getElementById("statusIdioma").innerText =
"Nova versão multilíngue registrada com sucesso.";

}

document.getElementById("idiomaOriginal").addEventListener("change", function(){
ajustarIdiomaDestino(this.value);
});

detectarIdiomaBase();

</script>

</body>
</html>
